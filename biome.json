{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": false
  },
  "files": {
    "includes": ["src/**", "test/**"]
  }
}
